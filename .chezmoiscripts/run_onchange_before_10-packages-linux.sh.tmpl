{{ if eq .chezmoi.os "linux" -}}
#!/bin/bash
set -eu
command -v apt-get >/dev/null 2>&1 || { echo "apt-get not found, skipping" >&2; exit 0; }

sudo=""
[ "$(id -u)" -ne 0 ] && sudo="sudo"

missing=""
for p in eza zoxide; do
    command -v "$p" >/dev/null 2>&1 || missing="$missing $p"
done
[ -z "$missing" ] && exit 0

$sudo apt-get update
for p in $missing; do
    $sudo apt-get install -y "$p" || echo "warning: could not install $p via apt" >&2
done
{{ end -}}

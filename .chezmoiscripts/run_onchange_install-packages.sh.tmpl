{{ if or (eq .chezmoi.os "darwin") (eq .chezmoi.os "linux") -}}
#!/usr/bin/env bash
set -eu
{{ if eq .chezmoi.os "darwin"}}
# package list hash: {{ .packages.darwin }}
{{ else if eq .chezmoi.os "linux" -}}
# package list hash: {{ .packages.linux }}
{{ end -}}
if [[ "{{ .chezmoi.os }}" == "darwin" ]]; then
  brew bundle --file=/dev/stdin <<EOF
{{ range .packages.darwin.homebrew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.homebrew.casks -}}
cask {{ . | quote }}
{{ end -}}
{{ range .packages.darwin.homebrew.taps -}}
tap {{ . | quote }}
{{ end -}}
EOF
  exit 0
fi

if [[ "{{ .chezmoi.os }}" == "linux" ]]; then
  sudo apt-get update
  sudo apt-get install -y {{ join " " .packages.linux.apt }}

  if ! command -v brew >/dev/null 2>&1; then
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
  elif [[ -x "$HOME/.linuxbrew/bin/brew" ]]; then
    eval "$("$HOME/.linuxbrew/bin/brew" shellenv)"
  fi

  if command -v brew >/dev/null 2>&1; then
    brew bundle --file=/dev/stdin <<EOF
{{ range .packages.linux.homebrew.formulae -}}
brew {{ . | quote }}
{{ end -}}
{{ range .packages.linux.homebrew.taps -}}
tap {{ . | quote }}
{{ end -}}
{{ range .packages.linux.homebrew.casks -}}
cask {{ . | quote }}
{{ end -}}
EOF
  fi

  # Install ble.sh from source (not in brew)
  if [[ ! -d ~/.local/share/blesh ]]; then
    tmpdir=$(mktemp -d)
    git clone --recursive --depth 1 --shallow-submodules https://github.com/akinomyoga/ble.sh.git "$tmpdir/ble.sh"
    make -C "$tmpdir/ble.sh" install PREFIX=~/.local
    rm -rf "$tmpdir"
  fi
fi
{{ end -}}

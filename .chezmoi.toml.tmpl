{{- $profile := "personal" -}}  
{{- if eq .chezmoi.hostname "work-laptop" -}}  
{{-   $profile = "work" -}}  
{{- end -}}  
  
[data]  
    profile = {{ $profile | quote }}

{{- if lookPath "code" }}  
[edit]  
    command = "code"  
    args = ["--wait"]  
[diff]  
    command = "code"  
    args = ["--wait", "--diff"]  
[merge]  
    command = "bash"  
    args = [  
        "-c",  
        {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},  
    ]  
{{- end }}  
  
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]

[git]
    autoCommit = true
    autoPush = true  
[gitHub]  
    refreshPeriod = "24h"
{{- $hosts := dict "work-laptop" "work" "desktop" "personal" "kaarels-macbook-air" "personal" -}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}
{{- $profile := get $hosts (lower $hostname) | default "remote" -}}

[data]
    profile = {{ $profile | quote }}

 
{{- /* real VS Code prints a bare "1.x.y"; the standalone CLI prints "code 1.x.y (commit ...)" */}}
{{- $vscode := false }}
{{- if lookPath "code" }}
{{-   $vscode = regexMatch "^[0-9]+\\.[0-9]+\\.[0-9]+" (output "code" "--version") }}
{{- end }}

{{- if $vscode }}
[edit]  
    command = "code"  
    args = ["--wait"]  
[diff]  
    command = "code"  
    args = ["--wait", "--diff"]  
[merge]  
    command = "bash"  
    args = [  
        "-c",  
        {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},  
    ]  
{{- end }}  
  
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]

[git]
    autoCommit = true
    autoPush = true  
[gitHub]  
    refreshPeriod = "24h"
[pinentry]
    command = "pinentry"
    args = ["--no-tty"]
[bitwarden]
    unlock = "auto"
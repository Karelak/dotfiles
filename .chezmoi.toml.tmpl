{{- $hosts := dict "work-laptop" "work" "home-pc" "personal" "macbook" "personal" -}}
{{- $profile := get $hosts (lower .chezmoi.hostname) -}}
{{- if not $profile -}}
{{-   $profile = promptChoiceOnce . "profile" "Profile" (list "work" "personal" "remote") "remote" -}}
{{- end -}}

[data]
    profile = {{ $profile | quote }}


{{- if lookPath "code" }}  
[edit]  
    command = "code"  
    args = ["--wait"]  
[diff]  
    command = "code"  
    args = ["--wait", "--diff"]  
[merge]  
    command = "bash"  
    args = [  
        "-c",  
        {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},  
    ]  
{{- end }}  
  
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]

[git]
    autoCommit = true
    autoPush = true  
[gitHub]  
    refreshPeriod = "24h"
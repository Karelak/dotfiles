{{- $hosts := dict "work-laptop" "desktop" "kaarels-macbook-air" -}}
{{- $hostname := .chezmoi.hostname -}}
{{- if eq .chezmoi.os "darwin" -}}
{{-   $hostname = output "scutil" "--get" "LocalHostName" | trim -}}
{{- end -}}
{{- $profile := get $hosts (lower $hostname) | default "remote" -}}

[data]
    profile = {{ $profile | quote }}


{{- if lookPath "code" }}  
[edit]  
    command = "code"  
    args = ["--wait"]  
[diff]  
    command = "code"  
    args = ["--wait", "--diff"]  
[merge]  
    command = "bash"  
    args = [  
        "-c",  
        {{ printf "%q" "cp {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} && code --new-window --wait --merge {{ .Destination | quote }} {{ .Target | quote }} {{ printf \"%s.base\" .Target | quote }} {{ .Source | quote }}" }},  
    ]  
{{- end }}  
  
[interpreters.ps1]
    command = "pwsh"
    args = ["-NoLogo", "-NoProfile"]

[git]
    autoCommit = true
    autoPush = true  
[gitHub]  
    refreshPeriod = "24h"
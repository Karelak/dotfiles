{{- if lookPath "code" }}
edit:
  command: code
  args:
    - "--wait"
diff:
  command: "code"
  args:
    - "--wait"
    - "--diff"
merge:
  command: "bash"
  args:
    - "-c"
    - 'cp {{ "{{ .Target }}" }} {{ "{{ .Target }}.base" }} && code --new-window --wait --merge {{ "{{ .Destination }}" }} {{ "{{ .Target }}" }} {{ "{{ .Target }}.base" }} {{ "{{ .Source }}" }}'
{{- end }}
git:
  autoCommit: true
  autoPush: true
github:
  refreshPeriod: 24h
bitwarden:
  unlock: true
{{- if eq .chezmoi.hostname "homelab" }}
pinentry:
  command: "pinentry-curses"
  args: ["--no-global-grab"]  
  options: ["allow-external-password-cache"]  
{{- end }}
